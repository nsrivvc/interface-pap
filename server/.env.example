# Paste your Neon connection string here (Neon console -> Connect -> Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require

# Any long random string
JWT_SECRET=change-me-to-a-long-random-secret

PORT=4000

# GitHub personal access token used to trigger the pipeline workflows
# (Actions -> read and write on the repo below). Fine-grained or classic
# "repo + workflow" scope both work.
GITHUB_TOKEN=

# The single repo that holds ALL pipeline workflows (stages 1-5), and the
# branch to run
PIPELINE_GITHUB_REPO=nsrivvc/STAGE_3_4_5
PIPELINE_GITHUB_REF=main
