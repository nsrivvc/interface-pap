# Paste your Neon connection string here (Neon console -> Connect -> Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require

# Any long random string
JWT_SECRET=change-me-to-a-long-random-secret

PORT=4000

# GitHub personal access token used to trigger the Stage 1/2 ingestion
# workflows (Actions -> read and write on the repo below). Fine-grained or
# classic "repo + workflow" scope both work.
GITHUB_TOKEN=

# The repo that holds the bronze_ingest*.yml workflows, and the branch to run
STAGE12_GITHUB_REPO=nsrivvc/STAGE_1_-_STAGE_2
STAGE12_GITHUB_REF=main
